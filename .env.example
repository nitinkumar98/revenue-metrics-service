# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "Transaction" pooler string on port 6543 for serverless-friendly connections,
# or the direct 5432 string if you're only ever running one long-lived process (e.g. on Render).
DATABASE_URL=postgres://postgres:[email protected]:5432/postgres

# Stripe TEST MODE secret key (starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_xxx

PORT=3000
